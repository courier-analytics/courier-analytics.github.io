[Unit]
Description=Verify tomorrow courier plan API without freezing a snapshot
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
UMask=0077
EnvironmentFile=-/etc/courier-analytics/proxy.env
TimeoutStartSec=180
ExecStart=/opt/courier-analytics/import-venv/bin/python /opt/courier-analytics/dashboard-code/tools/capture_plan.py --check-connection
